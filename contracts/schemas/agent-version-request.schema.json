{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/agent-version-request.schema.json",
  "title": "Create Agent Version Request",
  "description": "target_bearer_token_ref names a credential entered on the Credentials page; the token is never part of the request. DETERMINISTIC_CHAIN requires a Tool Catalog and SESSION_LLM_ONLY forbids one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "chat_endpoint", "target_bearer_token_ref", "target_model", "contract_version", "tool_evaluation_mode"],
  "properties": {
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "chat_endpoint": {"type": "string", "pattern": "^https?://", "maxLength": 2048},
    "target_bearer_token_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "target_model": {"type": "string", "minLength": 1, "maxLength": 255},
    "contract_version": {"const": "1.0"},
    "tool_evaluation_mode": {"enum": ["DETERMINISTIC_CHAIN", "SESSION_LLM_ONLY"]},
    "tool_catalog": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "input_schema"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
              "description": {"type": "string", "minLength": 1, "maxLength": 1000},
              "input_schema": {"type": "object"}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"tool_evaluation_mode": {"const": "DETERMINISTIC_CHAIN"}}, "required": ["tool_evaluation_mode"]},
      "then": {"required": ["tool_catalog"], "properties": {"tool_catalog": {"type": "array"}}},
      "else": {"properties": {"tool_catalog": {"type": "null"}}}
    }
  ]
}
