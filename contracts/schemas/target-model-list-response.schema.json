{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/target-model-list-response.schema.json",
  "title": "Target Platform Model List Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "capabilities"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 255},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["CHAT", "SSE", "TOOLS", "KNOWLEDGE"]}
          },
          "context_window": {"type": "integer", "minimum": 1},
          "max_output_tokens": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
