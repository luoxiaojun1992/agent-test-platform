{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/create-test-case.schema.json",
  "title": "create_test_case Tool Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "client_case_id", "scenario_revision_id",
    "dataset_revision_id", "turns", "knowledge_documents",
    "difficulty", "difficulty_profile", "generation_assumptions"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "job_id": {"$ref": "#/$defs/id"},
    "client_case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "scenario_revision_id": {"$ref": "#/$defs/id"},
    "dataset_revision_id": {"$ref": "#/$defs/id"},
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/turn"}
    },
    "knowledge_documents": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/knowledgeDocument"}},
    "difficulty": {"enum": ["EASY", "MEDIUM", "HARD", "EXTREME"]},
    "difficulty_profile": {"$ref": "#/$defs/difficultyProfile"},
    "generation_assumptions": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "prompt", "expected_output", "evaluation_criteria"],
      "properties": {
        "turn": {"type": "integer", "minimum": 1, "maximum": 16},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 4000},
        "expected_output": {"$ref": "#/$defs/expectedOutput"},
        "evaluation_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/criterion"}
        }
      }
    },
    "knowledgeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "text", "content_sha256", "metadata"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "text": {"type": "string", "minLength": 1, "maxLength": 64000, "contentMediaType": "text/plain"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "metadata": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "expectedOutput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"enum": ["EXACT", "SEMANTIC", "JSON"]},
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required"],
          "properties": {
            "type": {"const": "CONTAINS"},
            "required": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 1000}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "rules"],
          "properties": {
            "type": {"const": "CONSTRAINT"},
            "rules": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 1000}}
          }
        }
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "weight"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "difficultyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_complexity", "reasoning_complexity", "tool_complexity", "ambiguity", "multi_step", "state_change_complexity", "adversarial_complexity"],
      "properties": {
        "data_complexity": {"type": "integer", "minimum": 1, "maximum": 5},
        "reasoning_complexity": {"type": "integer", "minimum": 1, "maximum": 5},
        "tool_complexity": {"type": "integer", "minimum": 1, "maximum": 5},
        "ambiguity": {"type": "integer", "minimum": 1, "maximum": 5},
        "multi_step": {"type": "integer", "minimum": 1, "maximum": 5},
        "state_change_complexity": {"type": "integer", "minimum": 1, "maximum": 5},
        "adversarial_complexity": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}
