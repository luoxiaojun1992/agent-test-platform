{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/target-chat-event.schema.json",
  "title": "Target Platform Chat SSE Event",
  "oneOf": [
    {"$ref": "#/$defs/created"},
    {"$ref": "#/$defs/outputDelta"},
    {"$ref": "#/$defs/toolCall"},
    {"$ref": "#/$defs/toolResult"},
    {"$ref": "#/$defs/completed"},
    {"$ref": "#/$defs/terminalError"}
  ],
  "$defs": {
    "commonProperties": {
      "schema_version": {"const": "1.0"},
      "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
      "run_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
      "sequence": {"type": "integer", "minimum": 1, "maximum": 256},
      "created_at": {"type": "string", "format": "date-time"}
    },
    "created": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "run_id", "sequence", "type", "created_at"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "run_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
        "sequence": {"const": 1},
        "type": {"const": "response.created"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "outputDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "run_id", "sequence", "type", "created_at", "delta"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "run_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
        "sequence": {"type": "integer", "minimum": 2, "maximum": 256},
        "type": {"const": "response.output_text.delta"},
        "created_at": {"type": "string", "format": "date-time"},
        "delta": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "run_id", "sequence", "type", "created_at", "tool_sequence", "call_id", "tool_name", "arguments"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "run_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
        "sequence": {"type": "integer", "minimum": 2, "maximum": 256},
        "type": {"const": "response.tool_call"},
        "created_at": {"type": "string", "format": "date-time"},
        "tool_sequence": {"type": "integer", "minimum": 1, "maximum": 32},
        "call_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "parent_call_id": {"type": ["string", "null"], "maxLength": 128},
        "tool_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "arguments": {"type": "object"}
      }
    },
    "toolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "run_id", "sequence", "type", "created_at", "tool_sequence", "call_id", "duration_ms"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "run_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
        "sequence": {"type": "integer", "minimum": 2, "maximum": 256},
        "type": {"const": "response.tool_result"},
        "created_at": {"type": "string", "format": "date-time"},
        "tool_sequence": {"type": "integer", "minimum": 1, "maximum": 32},
        "call_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "duration_ms": {"type": "integer", "minimum": 0},
        "result": {"$ref": "#/$defs/result"},
        "error": {"$ref": "#/$defs/error"}
      },
      "oneOf": [
        {"required": ["result"], "not": {"required": ["error"]}},
        {"required": ["error"], "not": {"required": ["result"]}}
      ]
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "run_id", "sequence", "type", "created_at", "status", "final_output", "usage"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "run_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
        "sequence": {"type": "integer", "minimum": 2, "maximum": 256},
        "type": {"const": "response.completed"},
        "created_at": {"type": "string", "format": "date-time"},
        "status": {"const": "COMPLETED"},
        "final_output": {"type": "string", "minLength": 1, "maxLength": 16000},
        "usage": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/usage"}
          ]
        }
      }
    },
    "terminalError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "run_id", "sequence", "type", "created_at", "status", "error"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "run_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
        "sequence": {"type": "integer", "minimum": 2, "maximum": 256},
        "type": {"const": "response.error"},
        "created_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["AGENT_ERROR", "TIMEOUT"]},
        "error": {"$ref": "#/$defs/error"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "truncated"],
      "properties": {
        "status": {"const": "SUCCESS"},
        "output": {},
        "row_count": {"type": "integer", "minimum": 0},
        "affected_rows": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "original_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"truncated": {"const": true}}, "required": ["truncated"]},
          "then": {"required": ["original_bytes", "sha256"]}
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000},
        "retryable": {"type": "boolean"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      }
    }
  }
}
