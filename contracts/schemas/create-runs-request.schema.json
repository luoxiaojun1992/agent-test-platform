{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/create-runs-request.schema.json",
  "title": "Create Runs Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "test_case_revision_ids"],
  "properties": {
    "agent_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "test_case_revision_ids": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 10, "default": 1}
  }
}