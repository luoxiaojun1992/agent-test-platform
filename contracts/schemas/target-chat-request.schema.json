{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/target-chat-request.schema.json",
  "title": "Target Platform Chat Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "model", "message", "deadline", "knowledge_document_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "model": {"type": "string", "minLength": 1, "maxLength": 255},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "message": {"$ref": "#/$defs/message"},
    "deadline": {"type": "string", "format": "date-time"},
    "knowledge_document_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "content"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"const": "user"},
        "content": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    }
  }
}
