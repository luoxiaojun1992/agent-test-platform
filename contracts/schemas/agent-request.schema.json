{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/agent-request.schema.json",
  "title": "Create Agent Request",
  "description": "target_bearer_token_ref names a credential entered on the Credentials page; the token is never part of the request. tool_catalog lists the Tools the Agent under test supports and informs Test Case generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "chat_endpoint", "target_bearer_token_ref", "target_model", "contract_version"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "description": {"type": "string", "maxLength": 2000},
    "database_profile_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}]},
    "chat_endpoint": {"type": "string", "pattern": "^https?://", "maxLength": 2048},
    "target_bearer_token_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "client_id": {"type": "string", "maxLength": 255},
    "client_secret_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "token_url": {"type": "string", "pattern": "^https?://", "maxLength": 2048},
    "target_model": {"type": "string", "minLength": 1, "maxLength": 255},
    "contract_version": {"const": "1.0"},
    "tool_catalog": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "input_schema"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
              "description": {"type": "string", "minLength": 1, "maxLength": 1000},
              "input_schema": {"type": "object"}
            }
          }
        }
      ]
    }
  }
}
