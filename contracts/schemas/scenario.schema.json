{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/scenario.schema.json",
  "title": "Business Scenario Revision Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "domain", "required_capabilities", "business_rules", "difficulty", "difficulty_profile", "coverage_plan"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "description": {"type": "string", "minLength": 1, "maxLength": 4000},
    "domain": {"type": "string", "minLength": 1, "maxLength": 128},
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
    },
    "business_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source", "critical"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "source": {"enum": ["SOURCE_REQUIREMENT", "GENERATED_ASSUMPTION"]},
          "critical": {"type": "boolean"}
        }
      }
    },
    "difficulty": {"enum": ["EASY", "MEDIUM", "HARD", "EXTREME"]},
    "difficulty_profile": {"$ref": "#/$defs/difficultyProfile"},
    "coverage_plan": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["NORMAL", "EDGE_CASE", "AMBIGUOUS", "MULTI_STEP", "CONFLICT", "ADVERSARIAL"]}
    }
  },
  "$defs": {
    "difficultyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_complexity", "reasoning_complexity", "tool_complexity", "ambiguity", "multi_step", "state_change_complexity", "adversarial_complexity"],
      "properties": {
        "data_complexity": {"type": "integer", "minimum": 1, "maximum": 5},
        "reasoning_complexity": {"type": "integer", "minimum": 1, "maximum": 5},
        "tool_complexity": {"type": "integer", "minimum": 1, "maximum": 5},
        "ambiguity": {"type": "integer", "minimum": 1, "maximum": 5},
        "multi_step": {"type": "integer", "minimum": 1, "maximum": 5},
        "state_change_complexity": {"type": "integer", "minimum": 1, "maximum": 5},
        "adversarial_complexity": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}
