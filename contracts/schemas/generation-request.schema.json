{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/generation-request.schema.json",
  "title": "Generation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["description"],
  "properties": {
    "description": {"type": "string", "minLength": 1, "maxLength": 4000},
    "target_agent_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "generate_dataset": {"type": "boolean", "default": true},
    "database_profile_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "validation_db_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
    },
    "domain": {"type": "string", "minLength": 1, "maxLength": 128},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"enum": ["EASY", "MEDIUM", "HARD", "EXTREME"]},
        "max": {"enum": ["EASY", "MEDIUM", "HARD", "EXTREME"]}
      }
    },
    "test_case_count": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10},
    "coverage": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": {"enum": ["NORMAL", "EDGE_CASE", "AMBIGUOUS", "MULTI_STEP", "CONFLICT", "ADVERSARIAL"]}
    },
    "auto_activate": {"type": "boolean", "default": true},
    "require_manual_review": {"type": "boolean", "default": false},
    "job_kind": {"enum": ["SCENARIO", "DATASET", "TEST_CASES"]},
    "input_scenario_revision_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "input_dataset_revision_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"job_kind": {"const": "SCENARIO"}}, "required": ["job_kind"]},
      "then": {"not": {"anyOf": [{"required": ["input_scenario_revision_id"]}, {"required": ["input_dataset_revision_id"]}]}}
    },
    {
      "if": {"properties": {"job_kind": {"const": "DATASET"}}, "required": ["job_kind"]},
      "then": {"required": ["input_scenario_revision_id"], "not": {"required": ["input_dataset_revision_id"]}}
    },
    {
      "if": {"properties": {"job_kind": {"const": "TEST_CASES"}}, "required": ["job_kind"]},
      "then": {"required": ["input_scenario_revision_id", "input_dataset_revision_id"]}
    },
    {
      "if": {"not": {"required": ["job_kind"]}},
      "then": {
        "required": ["validation_db_ids"],
        "properties": {"validation_db_ids": {"minItems": 1}},
        "not": {"anyOf": [{"required": ["input_scenario_revision_id"]}, {"required": ["input_dataset_revision_id"]}]}
      }
    },
    {
      "if": {"properties": {"job_kind": {"const": "DATASET"}}, "required": ["job_kind"]},
      "then": {"required": ["validation_db_ids"], "properties": {"validation_db_ids": {"minItems": 1}}}
    },
    {
      "if": {
        "properties": {"generate_dataset": {"const": false}},
        "required": ["generate_dataset"]
      },
      "then": {"required": ["database_profile_id"]},
      "else": {"not": {"required": ["database_profile_id"]}}
    }
  ]
}
