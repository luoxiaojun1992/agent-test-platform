{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/critic-result.schema.json",
  "title": "Generation Semantic Critic Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "coverage", "case_findings", "package_findings", "confidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision": {"enum": ["ACCEPT", "REJECT"]},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "covered"],
      "properties": {
        "requested": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
        "covered": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 64}}
      }
    },
    "case_findings": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/finding"}
    },
    "package_findings": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/finding"}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "retryable"],
      "properties": {
        "client_case_id": {"type": ["string", "null"], "maxLength": 64},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "severity": {"enum": ["INFO", "WARNING", "ERROR", "CRITICAL"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
