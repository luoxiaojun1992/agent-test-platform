{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/judge-request.schema.json",
  "title": "LLM Judge Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_outcome", "prompt", "expected_output", "actual_output", "generation_assumptions", "deterministic_results", "tool_evaluation_mode", "expected_tool_call_chain", "actual_tool_calls", "tool_chain_match", "session_transcript", "evaluation_criteria"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "execution_outcome": {"enum": ["COMPLETED", "AGENT_ERROR", "TIMEOUT", "CANCELLED"]},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 4000},
    "expected_output": {"$ref": "create-test-case.schema.json#/$defs/expectedOutput"},
    "actual_output": {"type": ["string", "null"], "maxLength": 16000},
    "generation_assumptions": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1000}},
    "deterministic_results": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/deterministicResult"}
    },
    "tool_evaluation_mode": {"enum": ["DETERMINISTIC_CHAIN", "SESSION_LLM_ONLY"]},
    "expected_tool_call_chain": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "create-test-case.schema.json#/$defs/toolChain"}
      ]
    },
    "actual_tool_calls": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/toolCallEvidence"}
    },
    "tool_chain_match": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/toolChainMatch"}
      ]
    },
    "session_transcript": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/sessionEntry"}
    },
    "evaluation_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "create-test-case.schema.json#/$defs/criterion"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"tool_evaluation_mode": {"const": "DETERMINISTIC_CHAIN"}},
        "required": ["tool_evaluation_mode"]
      },
      "then": {
        "properties": {
          "expected_tool_call_chain": {"type": "object"},
          "tool_chain_match": {"type": "object"}
        }
      },
      "else": {
        "properties": {
          "expected_tool_call_chain": {"type": "null"},
          "tool_chain_match": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sessionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "type", "summary"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 256},
        "type": {"enum": ["OUTPUT_TEXT", "TOOL_CALL", "TOOL_RESULT", "ERROR"]},
        "summary": {"type": "object"}
      }
    },
    "deterministicResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "critical", "weight", "pass", "expected", "actual"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "category": {"enum": ["OUTPUT", "STATE", "MUTATION", "TOOL", "SAFETY"]},
        "critical": {"type": "boolean"},
        "weight": {"type": "number", "minimum": 0, "maximum": 1},
        "pass": {"type": "boolean"},
        "expected": {},
        "actual": {},
        "reason": {"type": "string", "maxLength": 1000}
      }
    },
    "toolCallEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "call_id", "tool_name", "arguments", "status", "result_summary", "trace_source"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 32},
        "call_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "tool_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "arguments": {"type": "object"},
        "status": {"enum": ["SUCCESS", "ERROR"]},
        "result_summary": {"type": "object"},
        "trace_source": {"enum": ["AGENT_REPORTED"]}
      }
    },
    "toolChainMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "critical_failure", "matched_steps", "violations", "score", "trace_trust"],
      "properties": {
        "pass": {"type": "boolean"},
        "critical_failure": {"type": "boolean"},
        "matched_steps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
        "violations": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 1000}},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "trace_trust": {"enum": ["AGENT_REPORTED"]}
      }
    }
  }
}
