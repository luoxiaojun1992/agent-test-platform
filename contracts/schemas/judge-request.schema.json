{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/judge-request.schema.json",
  "title": "LLM Judge Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_outcome", "prompt", "expected_output", "actual_output", "generation_assumptions", "session_context", "evaluation_criteria"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "execution_outcome": {"enum": ["COMPLETED", "AGENT_ERROR", "TIMEOUT", "CANCELLED"]},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 4000},
    "expected_output": {"$ref": "create-test-case.schema.json#/$defs/expectedOutput"},
    "actual_output": {"type": ["string", "null"], "maxLength": 16000},
    "generation_assumptions": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1000}},
    "session_context": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/contextItem"}
    },
    "evaluation_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "create-test-case.schema.json#/$defs/criterion"}
    }
  },
  "$defs": {
    "contextItem": {
      "oneOf": [
        {"$ref": "#/$defs/message"},
        {"$ref": "#/$defs/toolCall"},
        {"$ref": "#/$defs/toolResult"}
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "type", "role", "content", "created_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "type": {"const": "MESSAGE"},
        "role": {"enum": ["user", "assistant", "system", "tool"]},
        "content": {"type": "string", "maxLength": 16000},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "type", "tool_name", "arguments", "created_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "type": {"const": "TOOL_CALL"},
        "tool_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "arguments": {"type": "object"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "toolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "type", "tool_name", "status", "created_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "type": {"const": "TOOL_RESULT"},
        "tool_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "status": {"enum": ["SUCCESS", "ERROR"]},
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
            "message": {"type": "string", "minLength": 1, "maxLength": 2000}
          }
        },
        "created_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "SUCCESS"}}, "required": ["status"]},
          "then": {"required": ["result"], "not": {"required": ["error"]}}
        },
        {
          "if": {"properties": {"status": {"const": "ERROR"}}, "required": ["status"]},
          "then": {"required": ["error"], "not": {"required": ["result"]}}
        }
      ]
    }
  }
}
