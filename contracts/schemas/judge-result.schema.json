{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/judge-result.schema.json",
  "title": "LLM Judge Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "criteria", "tool_findings", "failure_categories", "overall_reason"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "score", "reason"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "score": {"type": "integer", "minimum": 0, "maximum": 100},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "tool_findings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "reason"],
        "properties": {
          "expected_step_id": {"type": ["string", "null"], "maxLength": 128},
          "actual_sequence": {"type": ["integer", "null"], "minimum": 1},
          "code": {"enum": ["WRONG_TOOL", "MISSING_TOOL", "TOOL_ARGUMENT_ERROR", "TOOL_SEQUENCE_ERROR", "TOOL_EXECUTION_ERROR", "UNAUTHORIZED_TOOL_CALL", "TRACE_MISMATCH", "UNNECESSARY_TOOL_CALL"]},
          "severity": {"enum": ["INFO", "WARNING", "ERROR", "CRITICAL"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "failure_categories": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": {
        "enum": ["WRONG_ANSWER", "INCOMPLETE_ANSWER", "SQL_ERROR", "WRONG_TOOL", "MISSING_TOOL", "TOOL_ARGUMENT_ERROR", "TOOL_SEQUENCE_ERROR", "TOOL_EXECUTION_ERROR", "UNAUTHORIZED_TOOL_CALL", "TRACE_MISMATCH", "BUSINESS_RULE_ERROR", "STATE_CHANGE_ERROR", "AMBIGUITY_HANDLING_ERROR", "INSTRUCTION_FOLLOWING_ERROR", "SAFETY_POLICY_ERROR", "TIMEOUT", "AGENT_ERROR"]
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "overall_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
