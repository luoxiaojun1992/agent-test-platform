{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/target-knowledge-upload-response.schema.json",
  "title": "Target Knowledge Text Upload Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "status", "content_sha256", "status_url", "accepted_at", "indexing_deadline"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["QUEUED", "INDEXING", "READY"]},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status_url": {"type": "string", "format": "uri-reference", "maxLength": 2048},
    "accepted_at": {"type": "string", "format": "date-time"},
    "indexing_deadline": {"type": "string", "format": "date-time"}
  }
}
