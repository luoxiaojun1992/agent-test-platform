{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/target-knowledge-upload-request.schema.json",
  "title": "Target Knowledge Text Upload Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "name", "text", "content_sha256", "indexing_deadline", "expires_at", "metadata"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "text": {"type": "string", "minLength": 1, "maxLength": 1000000, "contentMediaType": "text/plain"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "indexing_deadline": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {"type": "string", "maxLength": 1000}
    }
  }
}
