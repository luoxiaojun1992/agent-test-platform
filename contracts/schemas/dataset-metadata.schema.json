{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/dataset-metadata.schema.json",
  "title": "MySQL Dataset Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mysql_version", "timezone", "charset", "collation", "sql_mode", "tables", "difficulty_profile", "coverage_tags", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mysql_version": {"type": "string", "pattern": "^8\\.4(\\.[0-9]+)?$"},
    "timezone": {"const": "UTC"},
    "charset": {"const": "utf8mb4"},
    "collation": {"type": "string", "minLength": 1, "maxLength": 128},
    "sql_mode": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
    "tables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/table"}
    },
    "difficulty_profile": {"type": "object"},
    "coverage_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mysql_type", "nullable"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "mysql_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "nullable": {"type": "boolean"}
      }
    },
    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "referenced_table", "referenced_columns"],
      "properties": {
        "columns": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 128}},
        "referenced_table": {"type": "string", "minLength": 1, "maxLength": 128},
        "referenced_columns": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 128}}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "columns", "primary_key", "foreign_keys", "row_count"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "columns": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/column"}},
        "primary_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
        "foreign_keys": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/foreignKey"}},
        "row_count": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    }
  }
}
