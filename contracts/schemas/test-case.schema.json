{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/test-case.schema.json",
  "title": "Published Test Case Revision Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scenario_revision_id", "dataset_revision_id",
    "turns", "knowledge_documents",
    "difficulty", "difficulty_profile", "generation_assumptions"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "scenario_revision_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "dataset_revision_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "create-test-case.schema.json#/$defs/turn"}
    },
    "knowledge_documents": {"type": "array", "maxItems": 8, "items": {"$ref": "create-test-case.schema.json#/$defs/knowledgeDocument"}},
    "difficulty": {"enum": ["EASY", "MEDIUM", "HARD", "EXTREME"]},
    "difficulty_profile": {"$ref": "create-test-case.schema.json#/$defs/difficultyProfile"},
    "generation_assumptions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  }
}
