{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-test-platform.local/schemas/test-case.schema.json",
  "title": "Published Test Case Revision Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scenario_revision_id", "dataset_revision_id", "agent_mode",
    "prompt", "preconditions", "expected_output", "postconditions",
    "allowed_state_changes", "knowledge_documents", "tool_evaluation_mode", "expected_tool_call_chain", "evaluation_criteria",
    "difficulty", "difficulty_profile", "generation_assumptions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario_revision_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "dataset_revision_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "agent_mode": {"enum": ["ANSWER", "TASK"]},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 4000},
    "preconditions": {"type": "array", "maxItems": 32, "items": {"$ref": "create-test-case.schema.json#/$defs/sqlAssertion"}},
    "expected_output": {"$ref": "create-test-case.schema.json#/$defs/expectedOutput"},
    "postconditions": {"type": "array", "maxItems": 32, "items": {"$ref": "create-test-case.schema.json#/$defs/sqlAssertion"}},
    "allowed_state_changes": {"type": "array", "maxItems": 32, "items": {"$ref": "create-test-case.schema.json#/$defs/mutationRule"}},
    "knowledge_documents": {"type": "array", "maxItems": 8, "items": {"$ref": "create-test-case.schema.json#/$defs/knowledgeDocument"}},
    "tool_evaluation_mode": {"enum": ["DETERMINISTIC_CHAIN", "SESSION_LLM_ONLY"]},
    "expected_tool_call_chain": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "create-test-case.schema.json#/$defs/toolChain"}
      ]
    },
    "evaluation_criteria": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "create-test-case.schema.json#/$defs/criterion"}},
    "difficulty": {"enum": ["EASY", "MEDIUM", "HARD", "EXTREME"]},
    "difficulty_profile": {"$ref": "create-test-case.schema.json#/$defs/difficultyProfile"},
    "generation_assumptions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  },
  "allOf": [
    {
      "if": {"properties": {"agent_mode": {"const": "TASK"}}, "required": ["agent_mode"]},
      "then": {
        "properties": {
          "postconditions": {"minItems": 1, "contains": {"properties": {"critical": {"const": true}}, "required": ["critical"]}},
          "allowed_state_changes": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"tool_evaluation_mode": {"const": "DETERMINISTIC_CHAIN"}},
        "required": ["tool_evaluation_mode"]
      },
      "then": {
        "properties": {
          "expected_tool_call_chain": {
            "type": "object",
            "properties": {
              "steps": {"minItems": 1, "contains": {"properties": {"critical": {"const": true}}, "required": ["critical"]}}
            }
          }
        }
      },
      "else": {
        "properties": {"expected_tool_call_chain": {"type": "null"}}
      }
    }
  ]
}
