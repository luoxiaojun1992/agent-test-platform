# Development-only values. Use a secret manager and rotated values outside local development.
PLATFORM_MYSQL_ROOT_PASSWORD=change-me
PLATFORM_MYSQL_PASSWORD=change-me
TARGET_MYSQL_ROOT_PASSWORD=change-me
API_BEARER_TOKEN=change-me
# Encrypts test-environment credentials stored in Platform MySQL. Development-only key: base64 of 32 bytes.
# Rotation: add ATP_ENCRYPTION_KEY_K2, list k2 in SECRET_ENCRYPTION_KEY_IDS, set SECRET_ENCRYPTION_KEY_ID=k2,
# restart, then run cmd/secrets-rewrap (README: Rotating the encryption key).
SECRET_ENCRYPTION_KEY_ID=k1
SECRET_ENCRYPTION_KEY_IDS=k1
ATP_ENCRYPTION_KEY_K1=change-me
GENERATOR_CONFIG_SHA256=change-me

# Generation LLM. Defaults target the Compose Mock LLM.
GENERATION_MODEL_PROVIDER=openai
GENERATION_MODEL_BASE_URL=http://mock-llm:8081/v1
GENERATION_MODEL_API_TOKEN=change-me
GENERATION_MODEL_NAME=mock-generation-v1
GENERATION_MODEL_ALIAS=generation-primary
GENERATION_CONTEXT_WINDOW=32768
GENERATION_MAX_OUTPUT_TOKENS=4096
MOCK_LLM_BEARER_TOKEN=change-me
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_PORT=11434

# Target compatibility API. This token is unrelated to the platform and LLM tokens.
MOCK_TARGET_BEARER_TOKEN=change-me
MOCK_TARGET_MODEL=mock-agent-v1
MOCK_TARGET_INDEX_DELAY=2s

WEB_PORT=3000
API_PORT=8080
MOCK_LLM_PORT=8081
MOCK_TARGET_PORT=8082
PLATFORM_MYSQL_PORT=3307
TARGET_MYSQL_PORT=3309
